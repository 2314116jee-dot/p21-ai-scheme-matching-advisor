# ============================================================
# P21 Production Environment — Render.com Backend
# DO NOT commit actual secrets. Set these in Render dashboard.
# This file documents all required env vars.
# ============================================================

ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# ─── Database ─── Set in Render Dashboard ───────────────────
# From Neon.tech: Settings → Connection string (psycopg3 format)
# Format: postgresql+psycopg://user:password@hostname/dbname?sslmode=require
DATABASE_URL=SET_IN_RENDER_DASHBOARD

# ─── Security ── Auto-generated by Render ───────────────────
SECRET_KEY=SET_IN_RENDER_DASHBOARD
CSRF_SECRET=SET_IN_RENDER_DASHBOARD
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ─── CORS ── Add your Vercel URL after deploy ───────────────
# e.g. https://p21.vercel.app,https://p21-git-main-yourname.vercel.app
CORS_ORIGINS=SET_IN_RENDER_DASHBOARD

# ─── AI Provider ── Google Gemini (Free Tier) ───────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=SET_IN_RENDER_DASHBOARD
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=25
AI_ENABLED=true

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
