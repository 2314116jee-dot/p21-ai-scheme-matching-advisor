# Environment mode: development | hosted | production
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Database Configuration (PostgreSQL 17)
# For setup.ps1 / init-db.ps1 default provision:
DATABASE_URL=postgresql+psycopg://p21_user:p21_password@127.0.0.1:5432/p21
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=p21
PGUSER=p21_user
PGPASSWORD=p21_password

# Authentication & Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_SECRET=change_this_csrf_secret_key_in_production

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# AI Provider Layer (Ollama / Local LLM)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b
AI_TIMEOUT_SECONDS=60
AI_ENABLED=true

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60

# Optional First Admin Provisioning (used by scripts/create-admin.ps1)
# FIRST_ADMIN_NAME="Administrator"
# FIRST_ADMIN_EMAIL="admin@p21.gov.local"
# FIRST_ADMIN_PASSWORD="SecureAdminPassword123!"
